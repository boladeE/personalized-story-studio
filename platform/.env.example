# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Required in production: 32+ random characters used to sign unlock cookies.
SESSION_SECRET=

# Where gifts and songs are stored. On Railway, point this at a mounted volume.
DATA_DIR=.data

# AI songs. Leave both empty to use the studio score only.
# Preferred: Lyria 3.5 via the Gemini API (aistudio.google.com, paid tier; $0.08/song).
GEMINI_API_KEY=
# Fallback: Lyria 3 Pro (legacy) via OpenRouter.
OPENROUTER_API_KEY=
# MUSIC_PROVIDER=gemini   # gemini | openrouter | demo (short local test tones) | off
# GEMINI_MUSIC_MODEL=lyria-3.5
# MUSIC_MODEL=google/lyria-3-pro-preview
# MUSIC_DAILY_LIMIT=30
# MUSIC_HOURLY_PER_CLIENT=6
